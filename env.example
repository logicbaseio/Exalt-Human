# Added automatically by the Vercel Marketplace Neon integration.
POSTGRES_URL=

# Optional alias for non-Vercel environments.
DATABASE_URL=

# --- Exalt Space (/space) team access ---
# Comma-separated allowlist of team emails, and a shared access code they enter.
SPACE_ALLOWED_EMAILS=
SPACE_ACCESS_CODE=
# openssl rand -hex 32
SPACE_AUTH_SECRET=

# Live editor chat at /space — get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Editorial cron (protects /api/cron/editorial); Vercel Cron sends it as a Bearer token
CRON_SECRET=
# Set to 1 to let the daily cron auto-draft the next idea into review
CRON_AUTODRAFT=
